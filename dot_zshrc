# ==============================================================================
# 1. Oh My Zsh & 补全路径 (fpath 需在 oh-my-zsh.sh 之前)
# ==============================================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="" # 使用 Starship 接管提示符

plugins=(git jsontools sudo z zsh-autosuggestions zsh-syntax-highlighting)

[[ -d "$HOME/.grok/completions/zsh" ]] && fpath=("$HOME/.grok/completions/zsh" $fpath)
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ==============================================================================
# 2. 基础环境变量 & 默认编辑器
# ==============================================================================
export LANG=en_US.UTF-8

if (( $+commands[nvim] )); then
  export EDITOR='nvim'
  export VISUAL='nvim'
elif (( $+commands[vim] )); then
  export EDITOR='vim'
  export VISUAL='vim'
fi

# ==============================================================================
# 3. PATH 与开发工具链
# ==============================================================================
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
[[ -d "$HOME/.local/bin" && ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.pixi/bin" ]] && export PATH="$HOME/.pixi/bin:$PATH"
[[ -d "$HOME/.grok/bin" ]] && export PATH="$HOME/.grok/bin:$PATH"

# Go
if (( $+commands[go] )); then
  export GOPATH="$(go env GOPATH)"
  export PATH="$PATH:$GOPATH/bin"
fi

# vcpkg
if [[ -d "$HOME/code/vcpkg" ]]; then
  export VCPKG_ROOT="$HOME/code/vcpkg"
  export PATH="$VCPKG_ROOT:$PATH"
fi

# NVM
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && \. "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && \. "$NVM_DIR/bash_completion"

# ==============================================================================
# 4. 交互增强 (Starship / uv / fzf)
# ==============================================================================
(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[uv] )) && eval "$(uv generate-shell-completion zsh)"
(( $+commands[uvx] )) && eval "$(uvx --generate-shell-completion zsh)"

if (( $+commands[fd] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
  export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git'
fi
if (( $+commands[fzf] )) && fzf --zsh &>/dev/null; then
  source <(fzf --zsh)
fi

# ==============================================================================
# 5. 常用别名 (Aliases)
# ==============================================================================
if (( $+commands[eza] )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -lh --icons --git --group-directories-first'
  alias la='eza -alh --icons --git --group-directories-first'
  alias lt='eza -T -L 2 --icons --group-directories-first'
  alias ld='eza -D'
fi

alias dc='cd'

# Git 快捷别名（覆盖部分 Oh My Zsh git 插件默认定义）
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gpl='git pull --rebase'

# ==============================================================================
# 6. 本机私有/临时配置（不同步到 GitHub）
# ==============================================================================
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
